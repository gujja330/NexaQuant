<?xml version="1.0" encoding="UTF-16"?>
<!--
  NexaQuant OPS001-B Windows Task Scheduler definition.

  Import:
    schtasks /Create /TN "NexaQuant Ops Daemon" /XML deploy\task-scheduler\nexaquant.xml

  This task starts the OPS001-B daemon as a persistent background process.
  Task Scheduler restarts it if it exits with a non-zero code (RestartCount=3
  within 1 minute intervals).

  Adjust:
    <UserId>DOMAIN\svc-nexaquant</UserId>          -> your service account
    <WorkingDirectory>C:\opt\nexaquant</WorkingDirectory>   -> your install path
    <Arguments>C:\opt\nexaquant\scripts\nexaquant_daemon.py start</Arguments>

  The task runs whether the user is logged on or not, and restarts on failure.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>NexaQuant operations daemon (OPS001-B). Runs scheduled AEGIS + MON001 pipelines.</Description>
    <URI>\NexaQuant Ops Daemon</URI>
  </RegistrationInfo>

  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <UserId>DOMAIN\svc-nexaquant</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>C:\opt\nexaquant\scripts\nexaquant_daemon.py start</Arguments>
      <WorkingDirectory>C:\opt\nexaquant</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
