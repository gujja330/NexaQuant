execution/champion.json
execution/health.json

# DEV017 Market Intelligence Layer — data regenerates from yfinance; never commit large parquets
data/market_intelligence/

# Institutional Memory v1.0 — daily immutable archives (kept on disk, S3-syncable).
# Monthly digest (manifest of manifests) IS committed under reports/archive_digest_YYYY-MM.json.
data/archive/

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# data: KEEP the small analysis-TF gold parquets (repo stays reproducible, ~700KB).
# Exclude only the large execution-TF pulls (M5/M15 can be tens of MB).
data/raw/*_M5.parquet
data/raw/*_M15.parquet

# logs & local outputs
logs/*.log
*.log

