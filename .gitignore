*.pyc
.venv/
venv/
.ipynb_checkpoints/

# data: KEEP the small analysis-TF gold parquets (repo stays reproducible, ~700KB).
# Exclude only the large execution-TF pulls (M5/M15 can be tens of MB).
data/raw/*_M5.parquet
data/raw/*_M15.parquet

